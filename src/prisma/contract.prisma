// use prisma-8
model BannedWebhook {
  id    ObjectId @id @map("_id")
  reference     String   @unique
  reason String

  @@map("bannedwebhooks")
}

model BannedIP {
  id     ObjectId @id @map("_id")
  reference      String   @unique

  reason  String
  expires Date

  @@map("bannedips")
}

model WebhooksSeen {
  _id ObjectId @id @map("_id")
  reference  String   @unique

  @@map("seenwebhooks")
}
