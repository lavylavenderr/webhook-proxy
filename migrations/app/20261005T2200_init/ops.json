[
  {
    "id": "collection.bannedips.create",
    "label": "Create collection bannedips",
    "operationClass": "additive",
    "precheck": [
      {
        "description": "collection bannedips does not exist",
        "source": {
          "kind": "listCollections"
        },
        "filter": {
          "kind": "field",
          "field": "name",
          "op": "$eq",
          "value": "bannedips"
        },
        "expect": "notExists"
      }
    ],
    "execute": [
      {
        "description": "create collection bannedips",
        "command": {
          "kind": "createCollection",
          "collection": "bannedips",
          "validator": {
            "$jsonSchema": {
              "additionalProperties": false,
              "bsonType": "object",
              "properties": {
                "_id": {
                  "bsonType": "objectId"
                },
                "expires": {
                  "bsonType": "date"
                },
                "reason": {
                  "bsonType": "string"
                }
              },
              "required": [
                "_id",
                "expires",
                "reason"
              ]
            }
          },
          "validationLevel": "strict",
          "validationAction": "error"
        }
      }
    ],
    "postcheck": []
  },
